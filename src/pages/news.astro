---
import Layout from "../layout/Layout.astro";
import CardNews from "../parts/CardNews.astro";

// WordPress REST APIデータ取得
const res = await fetch(`${import.meta.env.PUBLIC_WP_API_URL}/posts?_embed`);
// データをJSON形式で取得
const posts = await res.json();
---

<Layout>
  <div class="container max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold">お知らせ</h1>
    <ul>
      {
        posts.map((post) => (
          <CardNews post={post} />
        ))
      }
    </ul>
    <div class="mt-5 text-center">
      <a href="/" class="btn">TOPへ戻る</a>
    </div>
  </div>
</Layout>

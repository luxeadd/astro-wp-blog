---
import "../styles/global.css";
export async function getStaticPaths() {
  const res = await fetch("https://sassy-creat.com/wp-json/wp/v2/posts");
  const posts = await res.json();
  const paths = posts.map((post) => ({
    params: {
      id: post.id,
    },
  }));
  return paths;
}

const { id } = Astro.params;
const res_post = await fetch(`https://sassy-creat.com/wp-json/wp/v2/posts/${id}`);
const post = await res_post.json();
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title set:html={post.title.rendered}></title>
    <link rel="stylesheet" href="https://sassy-creat.com/wp-content/themes/sango-theme/style.css">
  </head>
  <body>
    <div class="container max-w-xl mx-auto px-2">
      <h1 class="text-3xl font-bold" set:html={post.title.rendered}></h1>
      <div class="content mt-5">
        <p set:html={post.content.rendered}></p>
      </div>
      <div class="mt-5">
        <p>
          <a href="/">戻る</a>
        </p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  .content p {
    margin-bottom: 1em;
  }
</style>
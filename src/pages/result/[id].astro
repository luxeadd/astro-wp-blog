---
import Layout from "../../layout/Layout.astro";
// WordPress REST APIデータ取得
export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.PUBLIC_WP_API_URL}/result?_embed`);
  const results = await res.json();
  const paths = results.map((result) => ({
    params: {
      id: result.id,
    },
  }));
  return paths;
}
// パラメーター取得
const { id } = Astro.params;
const res = await fetch(`${import.meta.env.PUBLIC_WP_API_URL}/result/${id}?_embed`);
const result = await res.json();
// アイキャッチ画像URL取得
const featuredImageUrl = result._embedded["wp:featuredmedia"][0].source_url;

//ACFの画像を取得
const acfImgIds = [
  result.acf.result_desc.img, 
  result.acf.result_desc.result_items.result_item1.img, 
  result.acf.result_desc.result_items.result_item2.img
];

const acfImgUrls = await Promise.all(
  acfImgIds.map(async (imgId) => {
    const res = await fetch(`${import.meta.env.PUBLIC_WP_API_URL}/media/${imgId}`);
    const media = await res.json();
    return media.source_url;
  })
);

---


<Layout>
  <div class="container max-w-3xl mx-auto px-2">
    <h1 class="text-3xl font-bold" set:html={result.title.rendered} />
    <p class="text-sm text-gray-400">
      {result.date.substring(0, 10)}
    </p>
    {
      featuredImageUrl && (
        <div class="mt-5">
          <img
            src={featuredImageUrl}
            alt={result.title.rendered}
            class="w-full h-auto"
          />
        </div>
      )
    }
    <div class="content mt-5">
      <p class="text-gray-400" set:html={result.acf.result_slide.slogan} />
      <img src={acfImgUrls[0]} alt="">
      <p>{result.acf.result_desc.text}</p>
      <img src={acfImgUrls[1]} alt="">
      <p>{result.acf.result_desc.result_items.result_item1.text}</p>
      <img src={acfImgUrls[2]} alt="">
      <p>{result.acf.result_desc.result_items.result_item2.text}</p>
    </div>
    <div class="mt-5 text-center">
      <a href="/result" class="btn">戻る</a>
    </div>
  </div>
</Layout>

<style is:global>
  .content p {
    margin-bottom: 1em;
  }
</style>

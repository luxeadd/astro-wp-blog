---
import Layout from "../layout/Layout.astro";
// WordPress REST APIデータ取得
const res = await fetch(`${import.meta.env.PUBLIC_WP_API_URL}/result?_embed`);
const results = await res.json();
---

<Layout>
  <div class="container max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold">実績</h1>
    <ul>
      {
        results.map((result) => (
          <li class="mt-5">
            <a href={`/result/${result.id}`} class="flex items-center gap-6">
              <figure class="w-1/3">
                {result._embedded["wp:featuredmedia"][0].source_url && (
                  <img
                    src={result._embedded["wp:featuredmedia"][0].media_details.sizes.medium_large.source_url}
                    alt={result.title.rendered}
                  />
                )}
              </figure>
              <div class="w-2/3">
                <h2 class="font-bold" set:html={result.title.rendered} />
                <p class="text-sm text-gray-400">
                  {result.date.substring(0, 10)}
                </p>
                <div>
                  <p class="text-gray-400" set:html={result.acf.result_slide.slogan} />
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-5">
      <a href="/" class="btn">TOPへ戻る</a>
    </div>
  </div>
</Layout>

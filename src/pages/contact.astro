---

<Layout>
  <div class="mv relative h-[400px] bg-gradient-to-b from-indigo-50 to-white">
    <div class="absolute inset-0 flex items-center justify-center">
      <img
        src="/mv-animation.svg"
        alt="Welcome Animation"
        class="w-full max-w-3xl"
      />
    </div>
  </div>
  <div class="container max-w-xl mx-auto">
    <h1 class="text-3xl font-bold">お問い合わせ</h1>
    <form id="contact-form" class="space-y-4 mt-8">
      <!-- Contact Form 7のhiddenフィールド -->
      <!-- コンタクトフォーム7のフォームID -->
      <input type="hidden" name="_wpcf7" value="212" />
      <!-- コンタクトフォーム7のバージョン -->
      <input type="hidden" name="_wpcf7_version" value="6.0.6" />
      <!-- コンタクトフォーム7の言語 -->
      <input type="hidden" name="_wpcf7_locale" value="ja" />
      <!-- コンタクトフォーム7のユニットタグ -->
      <input type="hidden" name="_wpcf7_unit_tag" value="wpcf7-f212-p214-o1" />
      <!-- コンタクトフォーム7のコンテナポスト WP側のフォームが設置されているページのID -->
      <input type="hidden" name="_wpcf7_container_post" value="214" />
      <!-- コンタクトフォーム7の投稿データハッシュ -->
      <input type="hidden" name="_wpcf7_posted_data_hash" value="" />
      <label class="block">
        氏名
        <input
          type="text"
          name="your-name"
          autocomplete="name"
          required
          class="border p-2 w-full"
        />
      </label>
      <label class="block">
        メールアドレス
        <input
          type="email"
          name="your-email"
          autocomplete="email"
          required
          class="border p-2 w-full"
        />
      </label>
      <label class="block">
        題名
        <input
          type="text"
          name="your-subject"
          required
          class="border p-2 w-full"
        />
      </label>
      <label class="block">
        メッセージ本文 (任意)
        <textarea name="your-message" class="border p-2 w-full"></textarea>
      </label>
      <button type="submit" class="btn">送信</button>
    </form>
    {message && <p class="text-green-600">{message}</p>}
    {error && <p class="text-red-600">{error}</p>}
    <div class="mt-5">
      <a href="/" class="btn">トップページへ戻る</a>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document
      .getElementById("contact-form")
      .addEventListener("submit", async function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const res = await fetch(
          "https://test32.sassy-make.com/wp-json/contact-form-7/v1/contact-forms/212/feedback",
          {
            method: "POST",
            body: formData,
          }
        );
        const data = await res.json();
        alert(data.message);
      });
  });
</script>

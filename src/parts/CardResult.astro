---
const { result } = Astro.props;
---

<li class="mt-5">
  <a href={`/result/${result.id}`} class="flex items-center gap-6">
    <figure class="w-1/3">
      {result._embedded["wp:featuredmedia"][0].source_url && (
        <img
          src={
            result._embedded["wp:featuredmedia"][0].media_details
              .sizes.medium_large.source_url
          }
          alt={result.title.rendered}
        />
      )}
    </figure>
    <div class="w-2/3">
      <h2 class="font-bold" set:html={result.title.rendered} />
      <p class="text-sm text-gray-400">
        {result.date.substring(0, 10)}
      </p>
      <div>
        <p
          class="text-gray-400"
          set:html={result.acf.result_slide.slogan}
        />
      </div>
    </div>
  </a>
</li>
---
// 記事データを取得
const { post } = Astro.props;
// この記事のカテゴリー情報を取得
const categories = post._embedded["wp:term"][0];
---

<li class="mt-5">
  <a href={`/news/${post.id}`} class="flex items-center gap-6">
    <figure class="w-1/3">
      {post._embedded["wp:featuredmedia"][0].source_url && (
        <img
          src={
            post._embedded["wp:featuredmedia"][0].media_details
              .sizes.medium_large.source_url
          }
          alt={post.title.rendered}
        />
      )}
    </figure>
    <div class="w-2/3">
      <div class="flex items-center gap-2 mb-2">
        {categories.map((category) => (
          <a href={`/news/${category.slug}`} class="text-sm bg-gray-200 px-2 py-1 rounded-full">
            {category.name}
          </a>
        ))}
      </div>
      </div>
      <h2 class="font-bold" set:html={post.title.rendered} />
      <p class="text-sm text-gray-400">
        {post.date.substring(0, 10)}
      </p>
      <div>
        <p set:html={post.excerpt.rendered} />
      </div>
    </div>
  </a>
</li>